{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/m", "destination": "/public/mobile.html" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/remote", "destination": "/public/remote.html" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/m",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" }
      ]
    }
  ]
}
