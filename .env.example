# 伺服器監聽埠號（本機 / Node 託管使用）
PORT=3000

# 預設房間代碼
DEFAULT_ROOM=main

# 控場後台 (/admin) 與講者連線密碼
ADMIN_PASSWORD=2026

# 預設 Google Sheets 發布的 CSV 連結（留空則使用內建個人研習示範投影片）
DEFAULT_DECK_CSV_URL=
DEFAULT_CONFIG_CSV_URL=

# 選填：Upstash Redis（支援 1,000~3,000 人高併發）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 選填：Vercel Blob 雲端圖床（PDF 匯入與 AI 產圖儲存，Vercel 綁定 Blob Store 後自動注入）
BLOB_READ_WRITE_TOKEN=

# 選填：Google Gemini API Key（用於 /admin 內建 AI 一鍵生成插圖）
GEMINI_API_KEY=
