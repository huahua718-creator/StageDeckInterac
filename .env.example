# 伺服器監聽埠號（本機 / Node 託管使用）
PORT=3000

# 預設房間代碼
DEFAULT_ROOM=main

# 控場後台 (/admin) 與講者連線密碼
ADMIN_PASSWORD=2026

# 預設 Google Sheets 發布的 CSV 連結（留空則使用內建個人研習示範投影片）
# 取得方式：Google 試算表 -> 檔案 -> 共享 -> 發布到網路 -> 選擇「逗號分隔值 (.csv)」
DEFAULT_DECK_CSV_URL=
DEFAULT_CONFIG_CSV_URL=

# 選填：Upstash Redis（部署至 Vercel 支援 1,000~3,000 人高併發時使用）
# 若透過 Vercel Marketplace 綁定 Upstash Redis，會自動注入 UPSTASH_REDIS_REST_* 或 KV_REST_API_*
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
